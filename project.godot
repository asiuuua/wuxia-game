; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="武侠江湖"
config/description="等距2.5D武侠RPG · 数据驱动 + 模块化 + 企业级分层架构"
run/main_scene="res://scenes/bootstrap/Bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
application/boot_splash/image="res://assets/ui/splash.png"
application/boot_splash/fullsize=false
application/boot_splash/use_filter=true
application/boot_splash/bg_color=Color(0.102, 0.086, 0.071, 1)

[autoload]

EventBus="*res://autoload/EventBus.gd"
ConfigManager="*res://autoload/ConfigManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
GameState="*res://autoload/game_state.gd"
DifficultyManager="*res://autoload/difficulty_manager.gd"
SaveValidator="*res://autoload/save_validator.gd"
WeatherTimeService="*res://autoload/weather_time_service.gd"
AudioManager="*res://autoload/AudioManager.gd"
GameManager="*res://autoload/GameManager.gd"
DefeatHandler="*res://autoload/defeat_handler.gd"
UIManager="*res://autoload/ui_manager.gd"
SettingsManager="*res://autoload/settings_manager.gd"
LocalizationManager="*res://autoload/localization_manager.gd"
ErrorHandler="*res://autoload/error_handler.gd"
PerformanceMonitor="*res://tools/performance_monitor.gd"
PatchManager="*res://core/patch_manager.gd"
TransitionManager="*res://autoload/transition_manager.gd"
ObjectPool="*res://services/object_pool.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/viewport/width=1920
window/size/viewport/height=1080
window/size/minimum/width=960
window/size/minimum/height=540

[editor_plugins]

enabled=PackedStringArray("celebration_manager")

[gdscript]

warnings/unused_signal=0

[gui]

theme/custom="res://resources/themes/ui_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering/textures/canvas_textures/default_texture_filter=3

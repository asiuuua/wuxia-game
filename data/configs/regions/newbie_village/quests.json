{
  "version": "1.0.0",
  "_doc": "本区域任务链。主线由多步节点串成，prerequisites读取前置 flag，then_set 完成时写入小本子。",
  "quests": [
    {
      "id": "nv_quest_guard",
      "name": "守村御敌",
      "type": "main",
      "objectives": [
        { "id": "defend", "desc": "击退夜袭的山贼", "target_battle": "nv_battle_bandit", "need": 1 }
      ],
      "then_set": { "nv_flag_guard_done": true },
      "rewards": { "exp": 120, "items": [] }
    },
    {
      "id": "nv_quest_help_maiden",
      "name": "助送玉簪",
      "type": "main",
      "prerequisites": { "nv_flag_guard_done": true },
      "objectives": [
        { "id": "give_item", "desc": "将祖传玉簪送到迷烟镇金记铺", "need_item": "nv_item_hairpin", "need_count": 1 }
      ],
      "then_set": { "nv_flag_maiden_helped": true, "plot_advance": "to_misty_town" },
      "rewards": { "silver": 60, "items": [ { "item_id": "nv_item_wine", "count": 2 } ] }
    },
    {
      "id": "nv_qg_demo",
      "name": "烟雨楼失剑案·分支示例",
      "type": "quest_graph",
      "title_key": "qg_demo_title",
      "objectives": [],
      "_doc": "QuestGraph 分支示例：按 flag 走不同选项到不同结局。由 QuestGraph 解释器执行（对标巫师3 QuestGraph）。",
      "quest_graph": {
        "start_node": "n_start",
        "nodes": {
          "n_start": {
            "type": "start",
            "then": [ { "op": "flag_set", "key": "nv_qg_started", "value": true } ],
            "next": "n_choice"
          },
          "n_choice": {
            "type": "choice",
            "options": [
              {
                "text_key": "opt_help",
                "show": { "flag": "nv_flag_maiden_helped", "eq": true },
                "then": [ { "op": "flag_set", "key": "nv_qg_accepted", "value": true } ],
                "next": "n_give"
              },
              {
                "text_key": "opt_refuse",
                "show": { "flag": "nv_flag_maiden_helped", "eq": false },
                "then": [],
                "next": "n_end_refuse"
              }
            ]
          },
          "n_give": {
            "type": "flag_set",
            "then": [
              { "op": "favor_add", "target": "npc_village_chief", "value": 15 },
              { "op": "flag_set", "key": "nv_qg_rewarded", "value": true }
            ],
            "next": "n_end_good"
          },
          "n_end_good": { "type": "end", "ending": "good" },
          "n_end_refuse": { "type": "end", "ending": "neutral" }
        },
        "endings": [
          { "id": "good", "require": { "flag": "nv_qg_accepted", "eq": true } },
          { "id": "neutral", "require": { "flag": "nv_qg_accepted", "eq": false } }
        ]
      }
    }
  ]
}